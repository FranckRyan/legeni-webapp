# Application : ConfigMap + Deployment (probes, ressources, RollingUpdate sans coupure) + Service
apiVersion: v1
kind: ConfigMap
metadata:
  name: webapp-config
  namespace: {{ k8s_namespace }}
  labels: {app: webapp, env: {{ app_env }}}
data:
  APP_ENV: "{{ app_env }}"
  APP_COLOR: "{{ app_color }}"
  REDIS_HOST: redis
  REDIS_PORT: "6379"
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: webapp
  namespace: {{ k8s_namespace }}
  labels: {app: webapp, env: {{ app_env }}, app.kubernetes.io/part-of: legeni}
  annotations:
    kubernetes.io/change-cause: "deploy.yml {{ app_image }}:{{ app_version }}"
spec:
{% if not hpa_enabled %}
  replicas: {{ app_replicas }}
{% endif %}
  revisionHistoryLimit: 5
  strategy:
    type: RollingUpdate
    rollingUpdate: {maxSurge: 1, maxUnavailable: 0}   # jamais moins de pods prêts que demandé
  selector:
    matchLabels: {app: webapp}
  template:
    metadata:
      labels: {app: webapp, env: {{ app_env }}, version: "{{ app_version }}"}
      annotations:
        # change quand la configuration change => rolling update (les pods relisent la ConfigMap)
        checksum/config: "{{ (app_env ~ app_color) | hash('sha1') }}"
    spec:
      containers:
        - name: webapp
          image: "{{ app_image }}:{{ app_version }}"
          ports:
            - containerPort: 5000
          envFrom:
            - configMapRef: {name: webapp-config}
            - secretRef: {name: redis-secret}
          readinessProbe:
            httpGet: {path: {{ readiness_path }}, port: 5000}
            periodSeconds: 5
            failureThreshold: 2
          livenessProbe:
            httpGet: {path: /health, port: 5000}
            initialDelaySeconds: 10
            periodSeconds: 10
          resources:
            requests: {cpu: 50m, memory: 64Mi}
            limits: {cpu: 200m, memory: 128Mi}
---
apiVersion: v1
kind: Service
metadata:
  name: webapp
  namespace: {{ k8s_namespace }}
  labels: {app: webapp, env: {{ app_env }}}
spec:
  type: NodePort
  selector: {app: webapp}
  ports:
    - port: 80
      targetPort: 5000
      nodePort: {{ app_node_port }}
